<!--
  Legacy Auto Backup rules (API 23-30). We back up the user's preferences and
  the private gallery folder.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="gallery/" />
    <exclude domain="cache" path="." />
</full-backup-content>
