<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (API 31+). Mirrors backup_rules.xml for the newer
  cloud-backup / device-transfer model.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="gallery/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="gallery/" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
